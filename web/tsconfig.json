{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@gopherex/backplane-theme": [
        "packages/theme/src/index.ts"
      ],
      "@gopherex/backplane-errors": [
        "packages/errors/src/index.ts"
      ],
      "@gopherex/backplane-errors/*": [
        "packages/errors/src/*.ts"
      ],
      "@gopherex/backplane-ui": [
        "packages/ui/src/index.ts"
      ],
      "@gopherex/backplane-ui/*": [
        "packages/ui/src/*"
      ]
    }
  },
  "include": [
    "packages",
    "apps",
    "tests",
    "playwright.config.ts",
    "templates",
    "apps/catalog/.storybook",
    "playwright.storybook.config.ts"
  ]
}
